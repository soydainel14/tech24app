## Example environment configuration for the Tech24.do backend

# Database connection. Railway will inject these automatically, but
# during local development you must set them. The variables are read
# in priority order by src/db/knexfile.js:
#   1. DATABASE_URL – full MySQL connection string
#   2. MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
#   3. DB_HOST, DB_PORT, DB_USER, DB_PASS, DB_NAME
#
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=tech24do

# JWT secret used to sign authentication tokens
JWT_SECRET=change_me_to_a_strong_secret

# Allowed origins for CORS. Comma separated list of domains. Use
# * to allow any origin in development.
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Seed administrator credentials. The seed file will create an
# administrator account using these values on npm run seed. Adjust
# as needed during deployment.
ADMIN_EMAIL=admin@tech24.do
ADMIN_PASSWORD=Admin123!